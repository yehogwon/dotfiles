{
  "remoteControlAtStartup": true,
  "disableAgentView": true,
  "theme": "dark",
  "tui": "fullscreen",
  "permissions": {
    "defaultMode": "auto"
  },
  "skipAutoPermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "env": {
    "CLAUDE_CODE_SHELL": "/bin/bash",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.dotfiles/claude/mods"
  }
}
