{
  "remoteControlAtStartup": true,
  "env": {
    "CLAUDE_CODE_SHELL": "/bin/bash"
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    }
  },
  "enabledPlugins": {
    "claude-hud@claude-hud": true
  },
  "statusLine": {
    "type": "command",
    "command": "\"${DOTFILES_HOME:-$HOME/.dotfiles}/claude/hud-statusline\""
  }
}
