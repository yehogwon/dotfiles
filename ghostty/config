# Advertise xterm-256color like iTerm2, so no host ever needs xterm-ghostty's
# terminfo (a missing entry kills tmux, e.g. vast.ai's auto-tmux on login).
# ssh-terminfo stays off: it would re-upgrade remotes to xterm-ghostty
# based on a cache that can go stale. ssh-env still sends TERM_PROGRAM etc.
term = xterm-256color
shell-integration-features = ssh-env,no-ssh-terminfo
confirm-close-surface = false

# disable ligatures (e.g. != rendering as a single glyph)
font-feature = -calt
font-feature = -liga
font-feature = -dlig

# Option word-deletes as Meta, like Herdr's keys.json: ESC DEL / ESC d stop at
# punctuation (abc-def -> abc-). Without these, Opt+Delete sends CSI 3;3~,
# which Claude Code reads as "delete to end of line".
keybind = alt+backspace=text:\x1b\x7f
keybind = alt+delete=text:\x1bd
