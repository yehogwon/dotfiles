#!/usr/bin/env bash
# pull: pull the latest checkout, update submodules and reapply permissions
# After the git pull, the freshly pulled bin/pull runs the rest as `pull --pulled-from <commit before the pull>`.
# Keep accepting --pulled-from: older checkouts exec the new bin/pull with it.

set -euo pipefail

PERMISSIONS_MANIFEST_NAME=".permissions"

source "$(dirname -- "${BASH_SOURCE[0]}")/lib/ui.sh"
source "$(dirname -- "${BASH_SOURCE[0]}")/lib/permissions.sh"

is_git_worktree() {
    local dir="$1"

    git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

resolve_dotfiles_home() {
    if [[ -z "${DOTFILES_HOME:-}" ]]; then
        err "DOTFILES_HOME is not set"
        note "dotfiles is not set up yet, so there is nothing to pull"
        exit 1
    fi

    if [[ ! -d "$DOTFILES_HOME" ]]; then
        err "DOTFILES_HOME path not found: $DOTFILES_HOME"
        exit 1
    fi

    DOTFILES_HOME="$(realpath "$DOTFILES_HOME")"

    if ! is_git_worktree "$DOTFILES_HOME"; then
        err "DOTFILES_HOME is not a git checkout: $DOTFILES_HOME"
        exit 1
    fi
}

# "path hash" for each submodule's checked-out commit
submodule_heads() {
    git -C "$DOTFILES_HOME" submodule status --recursive 2>/dev/null | awk '{sub(/^[ +U-]/, ""); print $2, substr($1, 1, 7)}'
}

# One line for the submodules, then one per submodule the pull moved.
submodule_summary() {
    local before="$1" path hash old total=0 moved=0 lines=()

    while read -r path hash; do
        total=$((total + 1))
        old="$(awk -v p="$path" '$1 == p {print $2}' <<< "$before")"
        [[ "$old" != "$hash" ]] || continue
        moved=$((moved + 1))
        lines+=("$path ${old:-new} → $hash")
    done < <(submodule_heads)
    (( total )) || return 0
    ok "submodules: $total checked out, $moved moved"
    for path in ${lines[@]+"${lines[@]}"}; do
        note "$path"
    done
}

if [[ "${1:-}" != --pulled-from ]]; then
    header "dot pull"
    if ! command -v git >/dev/null 2>&1; then
        err "git is required"
        exit 1
    fi
    resolve_dotfiles_home
    before="$(git -C "$DOTFILES_HOME" rev-parse HEAD)"
    git_pull "$DOTFILES_HOME" || exit 1
    exec "$DOTFILES_HOME/bin/pull" --pulled-from "$before"
fi

resolve_dotfiles_home
pull_summary "$DOTFILES_HOME" "${2:?--pulled-from needs a commit}"

subs_before="$(submodule_heads)"
if ! out="$(git -C "$DOTFILES_HOME" submodule update --init --recursive --quiet 2>&1)"; then
    err "could not update submodules"
    err_output "$out"
    exit 1
fi
submodule_summary "$subs_before"

enforce_permissions_manifest "$DOTFILES_HOME" "$PERMISSIONS_MANIFEST_NAME"

UI_NESTED=1 bash "$DOTFILES_HOME/bin/vscode-theme" install || warn "VS Code theme update failed"
