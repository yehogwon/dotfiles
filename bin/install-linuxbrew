#!/usr/bin/env bash

set -euo pipefail

BREW_ROOT="$HOME/.linuxbrew"
BREW_REPO="$BREW_ROOT/Homebrew"
BREW_BIN_DIR="$BREW_ROOT/bin"
BREW_BIN="$BREW_BIN_DIR/brew"

source "$(dirname -- "${BASH_SOURCE[0]}")/lib/ui.sh"

run_quiet() {
    "$@" </dev/null >/dev/null 2>&1
}

is_linux_platform() {
    [[ "$(uname -s)" == "Linux" ]]
}

is_root_user() {
    [[ "$(id -u)" -eq 0 ]]
}

header "install Homebrew"

if ! is_linux_platform; then
    err "Homebrew installation at ~/.linuxbrew is only supported on Linux"
    exit 1
fi

# FIXME: installing linuxbrew this way requires building bin from source most of the time (almost always)
if is_root_user; then
    err "running this installer as root is very dangerous; Homebrew does not support it"
    exit 1
fi

if [[ -e "$BREW_ROOT" ]]; then
    if [[ -d "$BREW_ROOT" ]]; then
        skip "$BREW_ROOT already exists; Homebrew not installed again"
        exit 0
    fi

    err "$BREW_ROOT exists but is not a directory"
    exit 1
fi

if ! command -v git >/dev/null 2>&1; then
    err "git is required to install Homebrew"
    exit 1
fi

if ! mkdir -p "$BREW_ROOT"; then
    err "could not create $BREW_ROOT"
    exit 1
fi

if [[ -d "$BREW_REPO/.git" ]]; then
    :
elif [[ -e "$BREW_REPO" ]]; then
    err "$BREW_REPO exists and is not a git checkout"
    exit 1
else
    note "cloning Homebrew into $BREW_REPO (this may take a minute)..."
    if ! run_quiet git clone https://github.com/Homebrew/brew "$BREW_REPO"; then
        err "could not clone Homebrew"
        exit 1
    fi
    ok "cloned Homebrew into $BREW_REPO"
fi

if ! mkdir -p "$BREW_BIN_DIR"; then
    err "could not create $BREW_BIN_DIR"
    exit 1
fi

if ! ln -sfn "$BREW_REPO/bin/brew" "$BREW_BIN"; then
    err "could not link brew at $BREW_BIN"
    exit 1
fi
ok "linked brew at $BREW_BIN"

if ! run_quiet "$BREW_BIN" analytics off; then
    err "could not turn off Homebrew analytics"
    exit 1
fi
ok "turned off Homebrew analytics"

ok "Homebrew installed at $BREW_ROOT"
note "remove Homebrew anytime by deleting ~/.linuxbrew"
