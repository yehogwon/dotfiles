#!/usr/bin/env bash
# version [-l|--log]: show the checked-out commit and how far it is from the upstream main;
# --log also lists the commits a pull would bring in and those not yet pushed, or the last 10 when up to date

set -euo pipefail

DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
source "$DIR/bin/lib/ui.sh"
SPINNER=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)

usage() {
    printf 'usage: dot version [-l|--log]\n\n'
    printf '  -l, --log   also list the commits a pull would bring in and those not yet pushed,\n'
    printf '              or the last 10 when up to date\n'
}

show_log=0
case "$#:${1:-}" in
    0:) ;;
    1:--log|1:-l) show_log=1 ;;
    1:--help|1:-h) usage; exit 0 ;;
    *) usage >&2; exit 1 ;;
esac

remote="$(git -C "$DIR" config branch.main.remote 2>/dev/null || echo origin)"
upstream="$remote/main"

# A read-only fetch needs no auth, and GitHub answers HTTPS much faster than SSH,
# so fetch a git@github.com remote over HTTPS, falling back to the remote itself.
fetch() {
    local url
    url="$(git -C "$DIR" remote get-url "$remote" 2>/dev/null || true)"
    if [[ "$url" =~ ^(ssh://)?git@github\.com[:/](.+)$ ]]; then
        GIT_TERMINAL_PROMPT=0 git -C "$DIR" fetch --quiet "https://github.com/${BASH_REMATCH[2]}" \
            "+refs/heads/main:refs/remotes/$upstream" && return 0
    fi
    GIT_TERMINAL_PROMPT=0 git -C "$DIR" fetch --quiet "$remote" main
}

fetch < /dev/null > /dev/null 2>&1 &
fetch_pid=$!
if [[ -t 0 && -t 1 ]]; then
    # Keys typed meanwhile still echo, but are dropped before the shell gets them back.
    tty_state="$(stty -g)"
    restore() {
        perl -MPOSIX -e 'tcflush(0, TCIFLUSH)' 2>/dev/null || true
        stty "$tty_state"
        printf '\r\e[K\e[?25h'
    }
    trap restore EXIT
    trap 'exit 130' INT TERM
    printf '\e[?25l'
    i=0
    while kill -0 "$fetch_pid" 2>/dev/null; do
        printf '\r\e[%sm%s\e[0m checking version' "$UI_ACCENT" "${SPINNER[i++ % ${#SPINNER[@]}]}"
        sleep 0.1
    done
    restore
    trap - EXIT INT TERM
fi
fetched=1
wait "$fetch_pid" || fetched=0

# Commit time as "<two largest units> ago (<clock time>)", e.g. "1 day 3 hr ago (yesterday 20:25)".
when() { date -r "$1" "+$2" 2>/dev/null || date -d "@$1" "+$2"; }

ago() {
    local t="$1" now s i v r out clock
    local names=(year month week day hr min) secs=(31536000 2592000 604800 86400 3600 60)
    now="$(date +%s)"
    s=$(( now - t ))
    (( s < 60 )) && { echo "just now"; return; }

    for (( i = 0; i < ${#secs[@]}; i++ )); do (( s >= secs[i] )) && break; done
    unit() { [[ "$2" == hr || "$2" == min ]] && echo "$1 $2" || plural "$1" "$2"; }
    v=$(( s / secs[i] ))
    out="$(unit "$v" "${names[i]}")"
    if (( i + 1 < ${#secs[@]} )); then
        r=$(( s % secs[i] / secs[i + 1] ))
        (( r > 0 )) && out+=" $(unit "$r" "${names[i + 1]}")"
    fi

    if [[ "$(when "$t" %F)" == "$(when "$now" %F)" ]]; then clock="$(when "$t" %H:%M)"
    elif [[ "$(when "$t" %F)" == "$(when $(( now - 86400 )) %F)" ]]; then clock="yesterday $(when "$t" %H:%M)"
    elif (( s < 86400 * 6 )); then clock="$(when "$t" '%a %H:%M')"
    elif [[ "$(when "$t" %Y)" == "$(when "$now" %Y)" ]]; then clock="$(when "$t" '%b %-d')"
    else clock="$(when "$t" %F)"
    fi
    echo "$out ago ($clock)"
}

line() { ui_mark "$@"; }

hash="$(git -C "$DIR" rev-parse --short HEAD)"
subject="$(git --no-pager -C "$DIR" log -1 --format=%s HEAD)"
width="$(tput cols 2>/dev/null || echo 80)"
room=$(( width - ${#hash} - 4 ))
(( ${#subject} <= room )) || subject="${subject:0:room-1}…"
printf "${UI_BOLD}●$UI_RESET ${UI_BOLD}%s$UI_RESET %s\n" "$hash" "$subject"
printf "  ${UI_DIM}%s$UI_RESET\n" "committed $(ago "$(git --no-pager -C "$DIR" log -1 --format=%ct HEAD)")"

if ! git -C "$DIR" rev-parse --verify --quiet "$upstream" >/dev/null; then
    line "$UI_RED" ✗ "$upstream not found"
    exit 1
fi

read -r ahead behind < <(git -C "$DIR" rev-list --left-right --count "HEAD...$upstream")

if (( ahead == 0 && behind == 0 )); then
    line "$UI_GREEN" ✓ "up to date with $upstream"
elif (( ahead == 0 )); then
    line "$UI_YELLOW" ↓ "$(plural "$behind" commit) behind $upstream ${UI_DIM}(dot pull)$UI_RESET"
elif (( behind == 0 )); then
    line "$UI_YELLOW" ↑ "$(plural "$ahead" commit) ahead of $upstream ${UI_DIM}(dot push)$UI_RESET"
else
    line "$UI_YELLOW" ↕ "$(plural "$behind" commit) behind, $ahead ahead of $upstream"
fi
if (( show_log && ahead + behind == 0 )); then
    commit_lines "$DIR" -n 10 HEAD
elif (( show_log )); then
    base="$(git -C "$DIR" merge-base HEAD "$upstream")"
    label() { (( ahead > 0 && behind > 0 )) && printf '  %s%s%s\n' "$UI_DIM" "$1" "$UI_RESET"; return 0; }
    if (( behind > 0 )); then label incoming; changelog "$DIR" "$base" "$upstream"; fi
    if (( ahead > 0 )); then label unpushed; changelog "$DIR" "$base" HEAD; fi
fi
(( fetched )) || line "$UI_RED" ! "could not fetch; as of the last fetch"

changes="$(git -C "$DIR" status --porcelain | wc -l | tr -d ' ')"
(( changes == 0 )) || line "$UI_YELLOW" ± "$(plural "$changes" "uncommitted change")"
