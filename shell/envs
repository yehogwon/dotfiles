export LC_ALL=en_US.UTF-8

[ -d "$HOME/.local/bin" ] && export PATH="$HOME/.local/bin${PATH:+:$PATH}"
[ -d "$DOTFILES_HOME/shell/bin" ] && export PATH="$DOTFILES_HOME/shell/bin${PATH:+:$PATH}"

# fzf
FZF_HOME="$DOTFILES_HOME/modules/fzf"
[ -d "$FZF_HOME/bin" ] && export PATH="$FZF_HOME/bin${PATH:+:$PATH}"
if command -v fzf >/dev/null 2>&1; then
  if [ -n "$ZSH_VERSION" ]; then
    eval "$(fzf --zsh)"
  elif [ -n "$BASH_VERSION" ]; then
    eval "$(fzf --bash)"
  fi
fi

# herdr
if command -v herdr >/dev/null 2>&1; then
  if [ -n "${ZSH_VERSION-}" ]; then
    eval "$(herdr completion zsh)"
  elif [ -n "${BASH_VERSION-}" ]; then
    eval "$(herdr completion bash)"
  fi
fi

# linuxbrew
if [ -x "$HOME/.linuxbrew/bin/brew" ]; then
  eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
fi

# kubectl (zsh gets a cached completion from the oh-my-zsh kubectl plugin)
if [ -n "${BASH_VERSION-}" ] && command -v kubectl >/dev/null 2>&1; then
  source <(kubectl completion bash)
fi

# thefuck: defer the slow `thefuck --alias` (python startup) to first use
if command -v thefuck >/dev/null 2>&1; then
  fuck() {
    unset -f fuck
    eval "$(thefuck --alias)"
    fuck "$@"
  }
fi

# always use uv managed python
export UV_MANAGED_PYTHON=1
