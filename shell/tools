_wwatch_usage() {
    printf 'usage: wwatch [-n SECONDS] [--] <command> [args...]\n' >&2
}

# Start one run of the watched command. Under zsh it runs in a pseudo-terminal
# (zsh/zpty), so it keeps its colors and lays itself out for the pane; otherwise
# its output is captured from a background job.
_wwatch_start() {
    _ww_running=1
    sleep "$_ww_interval" &
    _ww_timer=$!

    if (( _ww_pty )); then
        : >| "$_ww_dir/out"
        : >| "$_ww_dir/rc"
        zpty -b _wwatch_cmd 'stty rows $(( _ww_rows - 1 )) cols $_ww_cols 2>/dev/null; eval "$_ww_cmd"; print -r -- $? >| "$_ww_dir/rc"'
    else
        (
            # bash turns alias expansion off in background subshells.
            [[ -n ${BASH_VERSION-} ]] && shopt -s expand_aliases
            export LINES=$(( _ww_rows - 1 )) COLUMNS=$_ww_cols
            eval "$_ww_cmd"
        ) >| "$_ww_dir/out" 2>&1 </dev/null &
        _ww_job=$!
    fi
}

# Collect what the running command has printed so far. Returns 0 once it has
# exited and its output is in _ww_output.
_wwatch_collect() {
    local exited=0

    if (( _ww_pty )); then
        # Copy whatever the pty has buffered; drain it fully once the command
        # is gone.
        zpty -t _wwatch_cmd || exited=1
        zpty -rt _wwatch_cmd >> "$_ww_dir/out"
        (( exited )) || return 1
        while zpty -rt _wwatch_cmd >> "$_ww_dir/out"; do :; done
        zpty -d _wwatch_cmd
        _ww_rc=$(<"$_ww_dir/rc")
    else
        kill -0 "$_ww_job" 2>/dev/null && return 1
        wait "$_ww_job"
        _ww_rc=$?
        _ww_job=""
    fi

    # Only the head can ever be on screen.
    _ww_output=$(head -n 1000 "$_ww_dir/out")
    _ww_output=${_ww_output//$'\r'/}
    _ww_clock=$(date +%H:%M:%S)
    _ww_running=0
}

# Rewrite only the screen rows that changed since the last frame, in one write.
_wwatch_render() {
    [[ -n ${ZSH_VERSION-} ]] && setopt localoptions ksharrays
    local -a rows
    local left right badge="" pad line frame="" room i

    left="Every ${_ww_interval}s: $_ww_title"
    right=$_ww_host
    [[ -n $_ww_clock ]] && right+="  $_ww_clock"
    [[ ${_ww_rc:-0} != 0 ]] && badge="[exit $_ww_rc]  "
    room=$(( _ww_cols - ${#badge} - ${#right} - 1 ))
    (( room < 0 )) && room=0
    (( ${#left} > room )) && left=${left:0:$room}
    i=$(( _ww_cols - ${#left} - ${#badge} - ${#right} ))
    (( i < 1 )) && i=1
    printf -v pad '%*s' "$i" ''
    rows=($'\e[1;33m'"$left$pad"$'\e[1;31m'"$badge"$'\e[1;33m'"$right"$'\e[m')

    if (( _ww_rows > 1 )); then
        while IFS= read -r line || [[ -n $line ]]; do
            rows+=("$line")
            (( ${#rows[@]} >= _ww_rows )) && break
        done <<< "$_ww_output"
    fi

    for (( i = 0; i < _ww_rows; i++ )); do
        line=${rows[i]-}
        if (( i >= ${#_ww_drawn[@]} )) || [[ ${_ww_drawn[i]} != "$line" ]]; then
            frame+=$'\e['"$(( i + 1 ))"$';1H\e[m\e[K'"$line"
            _ww_drawn[i]=$line
        fi
    done

    [[ -n $frame ]] && printf '%s' $'\e[?2026h'"$frame"$'\e[m\e[?2026l'
}

_wwatch_cleanup() {
    # A closing pane can deliver SIGHUP twice; don't let the second one cut
    # the cleanup short.
    trap '' INT HUP TERM
    exec 2>/dev/null
    (( _ww_pty )) && zpty -d _wwatch_cmd
    if [[ -n $_ww_job ]]; then
        pkill -P "$_ww_job"
        kill "$_ww_job"
    fi
    [[ -n $_ww_timer ]] && kill "$_ww_timer"
    rm -rf "$_ww_dir"

    # Restore the terminal last: if the pane is already gone, zsh abandons the
    # rest of this trap at the failed /dev/tty redirection.
    printf '\e[?7h\e[?25h\e[?1049l'
    [[ -n $_ww_tty ]] && stty "$_ww_tty" </dev/tty
}

wwatch() {
    local _ww_interval=1

    while (( $# )); do
        case $1 in
            -n|--interval)
                if (( $# < 2 )); then
                    _wwatch_usage
                    return 2
                fi
                _ww_interval=$2
                shift 2
                ;;
            -n?*) _ww_interval=${1#-n}; shift ;;
            --interval=*) _ww_interval=${1#*=}; shift ;;
            -h|--help) _wwatch_usage; return 0 ;;
            --) shift; break ;;
            *) break ;;
        esac
    done

    if (( $# == 0 )); then
        _wwatch_usage
        return 2
    fi

    if [[ $_ww_interval == *[!0-9.]* || $_ww_interval == *.*.* || $_ww_interval != *[1-9]* ]]; then
        printf 'wwatch: invalid interval: %s\n' "$_ww_interval" >&2
        return 2
    fi

    if [[ ! -t 1 ]] || ! : </dev/tty 2>/dev/null; then
        printf 'wwatch: needs a terminal\n' >&2
        return 1
    fi

    # A single argument is a shell snippet; several are a command and its
    # arguments. Both go through eval so aliases and functions keep working.
    local _ww_cmd _ww_title=$* _ww_host
    if (( $# == 1 )); then
        _ww_cmd=$1
    else
        _ww_cmd=$(printf '%q ' "$@")
        _ww_cmd=${_ww_cmd% }
    fi
    _ww_host=$(hostname -s 2>/dev/null) || _ww_host=$(hostname)

    local _ww_dir="" _ww_tty="" _ww_job="" _ww_timer="" _ww_pty=0 _ww_poll=0.1
    local _ww_running=0 _ww_force=0 _ww_rows=0 _ww_cols=0 _ww_size="" _ww_key=""
    local _ww_output="" _ww_rc=0 _ww_clock=""
    local -a _ww_drawn

    if [[ -n ${ZSH_VERSION-} ]]; then
        zmodload zsh/zpty 2>/dev/null && _ww_pty=1
    elif (( BASH_VERSINFO[0] < 4 )); then
        _ww_poll=1  # bash 3 only takes whole-second read timeouts
    fi

    (
        _ww_dir=$(mktemp -d "${TMPDIR:-/tmp}/wwatch.XXXXXX") || exit 1
        _ww_tty=$(stty -g </dev/tty)
        trap _wwatch_cleanup EXIT
        trap 'exit 130' INT
        trap 'exit 129' HUP
        trap 'exit 143' TERM

        stty -echo -icanon </dev/tty
        printf '\e[?1049h\e[?25l\e[?7l\e[2J'

        while :; do
            _ww_size=$(stty size </dev/tty)
            if [[ $_ww_size != "$_ww_rows $_ww_cols" ]]; then
                _ww_rows=${_ww_size% *}
                _ww_cols=${_ww_size#* }
                _ww_drawn=()
                _wwatch_render
            fi

            if (( _ww_running )); then
                _wwatch_collect && _wwatch_render
            elif (( _ww_force )) || [[ -z $_ww_timer ]] || ! kill -0 "$_ww_timer" 2>/dev/null; then
                _ww_force=0
                _wwatch_start
            fi

            _ww_key=""
            if [[ -n ${ZSH_VERSION-} ]]; then
                read -t "$_ww_poll" -k 1 _ww_key
            else
                IFS= read -r -s -n 1 -t "$_ww_poll" _ww_key </dev/tty
            fi
            case $_ww_key in
                q|Q) exit 0 ;;
                ' ') _ww_force=1 ;;
            esac
        done
    )
}

function _slurm_get_field() {
    local job_id="$1"
    local field="$2"

    local line
    if ! line=$(scontrol show job -o "$job_id" 2>/dev/null); then
        print_red "scontrol failed for job $job_id"
        return 1
    fi

    local result
    result=$(awk -v key="$field" '{
        for (i = 1; i <= NF; i++) {
            if ($i ~ ("^" key "=")) {
                sub("^" key "=", "", $i)
                print $i
                exit
            }
        }
    }' <<< "$line")

    if [[ -z "$result" ]]; then
        print_red "Field $field not found for job $job_id"
        return 1
    fi

    printf '%s\n' "$result"
    return 0
}

function _slurm_try_get_field() {
    local job_id="$1"
    local field="$2"

    local line
    if ! line=$(scontrol show job -o "$job_id" 2>/dev/null); then
        return 1
    fi

    awk -v key="$field" '{
        for (i = 1; i <= NF; i++) {
            if ($i ~ ("^" key "=")) {
                sub("^" key "=", "", $i)
                print $i
                exit
            }
        }
    }' <<< "$line"
}

function _slurm_first_host_from_nodelist() {
    local nodelist="$1"

    [ -n "$nodelist" ] || return 1
    [ "$nodelist" != "(null)" ] || return 1

    local first_host
    first_host=$(scontrol show hostnames "$nodelist" 2>/dev/null | while IFS= read -r host; do
        printf '%s\n' "$host"
        break
    done) || return 1

    [ -n "$first_host" ] || return 1
    printf '%s\n' "$first_host"
}

function _slurm_detect_log_host() {
    local job_id="$1"

    local batch_host
    batch_host=$(_slurm_try_get_field "$job_id" "BatchHost")
    if [ -n "$batch_host" ] && [ "$batch_host" != "(null)" ]; then
        printf '%s\n' "$batch_host"
        return 0
    fi

    local nodelist
    nodelist=$(_slurm_try_get_field "$job_id" "NodeList") || return 1
    _slurm_first_host_from_nodelist "$nodelist"
}

function _slurm_is_remote_path() {
    local location="$1"
    local remote_prefix="${location%%:*}"
    local remote_path="${location#*:}"

    [ "$remote_prefix" != "$location" ] || return 1
    [ -n "$remote_prefix" ] || return 1
    [ "${remote_prefix#*/}" = "$remote_prefix" ] || return 1
    [ "${remote_path#/}" != "$remote_path" ] || return 1

    return 0
}

function _slurm_compose_log_location() {
    local path="$1"
    local ssh_host="$2"

    if _slurm_is_remote_path "$path"; then
        printf '%s\n' "$path"
        return 0
    fi

    if [ -n "$ssh_host" ]; then
        if [ "${path#/}" = "$path" ]; then
            print_red "Remote log path must be absolute when using ssh_host: $path"
            return 1
        fi

        printf '%s:%s\n' "$ssh_host" "$path"
        return 0
    fi

    printf '%s\n' "$path"
    return 0
}

function _slurm_split_log_location() {
    local location="$1"

    if _slurm_is_remote_path "$location"; then
        printf 'remote\n%s\n%s\n' "${location%%:*}" "${location#*:}"
        return 0
    fi

    printf 'local\n\n%s\n' "$location"
    return 0
}

function _slurm_quote_for_shell() {
    printf '%q' "$1"
}

function _slurm_run_ssh() {
    local ssh_host="$1"
    local remote_command="$2"

    ssh -- "$ssh_host" "$remote_command"
}

function slurm_out() {
    if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
        print_red "Usage: slurm_out <job_id> [ssh_host]"
        return 1
    fi

    local file
    file=$(_slurm_get_field "$1" "StdOut") || return 1
    _slurm_compose_log_location "$file" "$2"
}

function slurm_err() {
    if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
        print_red "Usage: slurm_err <job_id> [ssh_host]"
        return 1
    fi

    local file
    file=$(_slurm_get_field "$1" "StdErr") || return 1
    _slurm_compose_log_location "$file" "$2"
}

function _show_file() {
    local mode="$1"  # cat or tail
    local job_id="$2"
    local file_func="$3"
    local ssh_host="$4"

    local location
    location=$("$file_func" "$job_id" "$ssh_host") || return 1

    local target_kind remote_host file
    {
        IFS= read -r target_kind
        IFS= read -r remote_host
        IFS= read -r file
    } <<EOF
$(_slurm_split_log_location "$location")
EOF

    if [ "$target_kind" = "remote" ]; then
        local quoted_file
        quoted_file=$(_slurm_quote_for_shell "$file")

        if [ "$mode" = "cat" ]; then
            local check_status
            _slurm_run_ssh "$remote_host" "test -f $quoted_file"
            check_status=$?

            if [ "$check_status" -ne 0 ]; then
                if [ "$check_status" -eq 1 ]; then
                    print_red "File does not exist: $location"
                else
                    print_red "ssh failed while checking file: $location"
                fi
                return "$check_status"
            fi

            print_green "Displaying file: $location"
            _slurm_run_ssh "$remote_host" "cat -- $quoted_file"
            return $?
        fi

        print_green "Tracking file: $location"
        _slurm_run_ssh "$remote_host" "tail -F -- $quoted_file"
        return $?
    fi

    local auto_host=""
    if [ -z "$ssh_host" ] && [ ! -f "$file" ]; then
        auto_host=$(_slurm_detect_log_host "$job_id")
        if [ -n "$auto_host" ]; then
            location=$(_slurm_compose_log_location "$file" "$auto_host") || return 1
            {
                IFS= read -r target_kind
                IFS= read -r remote_host
                IFS= read -r file
            } <<EOF
$( _slurm_split_log_location "$location" )
EOF
        fi
    fi

    if [ "$target_kind" = "remote" ]; then
        local quoted_file
        quoted_file=$(_slurm_quote_for_shell "$file")

        if [ "$mode" = "cat" ]; then
            local check_status
            _slurm_run_ssh "$remote_host" "test -f $quoted_file"
            check_status=$?

            if [ "$check_status" -ne 0 ]; then
                if [ "$check_status" -eq 1 ]; then
                    print_red "File does not exist: $location"
                else
                    print_red "ssh failed while checking file: $location"
                fi
                return "$check_status"
            fi

            print_green "Displaying file: $location"
            _slurm_run_ssh "$remote_host" "cat -- $quoted_file"
            return $?
        fi

        print_green "Tracking file: $location"
        _slurm_run_ssh "$remote_host" "tail -F -- $quoted_file"
        return $?
    fi

    if [ "$mode" = "cat" ]; then
        if [ ! -f "$file" ]; then
            print_red "File does not exist: $file"
            return 1
        fi
        print_green "Displaying file: $file"
        cat "$file"
    else
        print_green "Tracking file: $file"
        tail -F "$file"
    fi
}

function cat_out() {
    if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
        print_red "Usage: cat_out <job_id> [ssh_host]"
        return 1
    fi
    _show_file "cat" "$1" slurm_out "$2"
}

function track_out() {
    if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
        print_red "Usage: track_out <job_id> [ssh_host]"
        return 1
    fi
    _show_file "tail" "$1" slurm_out "$2"
}

