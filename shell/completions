# dot: complete subcommands from dot --commands

if [ -n "${ZSH_VERSION-}" ]; then
    _dot() {
        if (( CURRENT == 2 )); then
            local -a cmds
            cmds=( ${(f)"$(command dot --commands 2>/dev/null)"} )
            _describe 'dot command' cmds
        else
            _files
        fi
    }
    (( $+functions[compdef] )) && compdef _dot dot
elif [ -n "${BASH_VERSION-}" ]; then
    _dot() {
        if [ "$COMP_CWORD" -eq 1 ]; then
            COMPREPLY=( $(compgen -W "$(command dot --commands 2>/dev/null)" -- "${COMP_WORDS[1]}") )
        else
            COMPREPLY=( $(compgen -f -- "${COMP_WORDS[COMP_CWORD]}") )
        fi
    }
    complete -o filenames -F _dot dot
fi
