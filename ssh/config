Match host "github.com" exec "test -r ~/.ssh/kwak"
    HostName github.com
    User git
    IdentityFile ~/.ssh/kwak
    LogLevel ERROR

Match host "hf.co" exec "test -r ~/.ssh/kwak"
    HostName hf.co
    User git
    IdentityFile ~/.ssh/kwak
    LogLevel ERROR

Match host "kwak*" exec "test -r ~/.ssh/kwak"
    IdentityFile ~/.ssh/kwak
    LogLevel ERROR
